# Writes OUTPUT_FILE with a hash of the sources that decide what shader store records hold, so a
# store survives rebuilds that do not change them. SOURCE_LIST is a file listing those sources.
file(STRINGS "${SOURCE_LIST}" sources)
list(SORT sources)
set(combined "")
foreach(source IN LISTS sources)
	file(SHA256 "${source}" digest)
	string(APPEND combined "${digest}")
endforeach()
string(SHA256 digest "${combined}")
string(SUBSTRING "${digest}" 0 16 digest)
file(WRITE "${OUTPUT_FILE}.tmp"
	"// Generated by shader_store_version.cmake.\n#pragma once\n#define KYTY_SHADER_STORE_VERSION 0x${digest}ull\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}")
file(REMOVE "${OUTPUT_FILE}.tmp")
